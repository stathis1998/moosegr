---
import "@/index.css";

import type { Locale } from "@/lib/i18n";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** OG/Twitter title & description — default to the page title/description. */
  ogTitle?: string;
  ogDescription?: string;
  /** Canonical path of this page, e.g. "/", "/el/", "/privacy.html". */
  path: string;
  /** This page's URL in each language, for hreflang alternates. */
  enPath: string;
  elPath: string;
}

const {
  locale,
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  path,
  enPath,
  elPath,
} = Astro.props;

const site = "https://moose.gr";
const canonical = site + path;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon-white.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-white-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-white-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-white.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0e9384" />

    <!-- Consent Mode v2 bootstrap. All Google tags (GA4 G-7KQ7KMQM65, Ads
         AW-18369329164) are configured inside the GTM container below — do
         not add gtag.js / gtag('config') here again or they double-count.
         The gtag() helper only pushes consent/set commands, which GTM reads
         from the shared dataLayer. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      // Consent Mode v2, region-aware: consent is only legally required in the
      // EEA/UK/CH, so default to granted elsewhere — a global "denied" default
      // trips Google Ads' "0% consent rate" diagnostic and drops measurement
      // for visitors who never needed a banner.
      gtag('consent', 'default', {
        ad_storage: 'granted',
        ad_user_data: 'granted',
        ad_personalization: 'granted',
        analytics_storage: 'granted',
      });
      // EEA + UK + CH: deny until the visitor answers the banner. The more
      // specific region setting takes precedence over the global one above.
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
        region: ['AT','BE','BG','HR','CY','CZ','DK','EE','FI','FR','DE','GR',
                 'HU','IS','IE','IT','LV','LI','LT','LU','MT','NL','NO','PL',
                 'PT','RO','SK','SI','ES','SE','GB','CH'],
      });

      // Recover ad-click and conversion data even while consent is denied
      // (cookieless pings + URL passthrough), per Google's consent-mode docs.
      gtag('set', 'url_passthrough', true);
      gtag('set', 'ads_data_redaction', true);

      // Returning visitors: replay the stored choice before config runs.
      // Both values matter — a stored "denied" must override the granted
      // default that non-EEA visitors now start with.
      try {
        var storedConsent = localStorage.getItem('cookie-consent');
        if (storedConsent === 'granted' || storedConsent === 'denied') {
          gtag('consent', 'update', {
            ad_storage: storedConsent,
            ad_user_data: storedConsent,
            ad_personalization: storedConsent,
            analytics_storage: storedConsent,
          });
        }
      } catch (e) {}
    </script>

    <!-- Google Tag Manager -->
    <!-- Must stay below the consent bootstrap above: the container reads the
         Consent Mode defaults from the shared dataLayer when it loads. -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-T4JVVFKQ');
    </script>
    <!-- End Google Tag Manager -->

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={site + enPath} />
    <link rel="alternate" hreflang="el" href={site + elPath} />
    <link rel="alternate" hreflang="x-default" href={site + enPath} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Moose Software Solutions" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/og-image.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Moose Software Solutions — Custom Software Solutions that Scale"
    />
    <meta property="og:locale" content={locale === "el" ? "el_GR" : "en_US"} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={`${site}/og-image.jpg`} />

    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "Moose Software Solutions",
        "legalName": "MOOSE SOFTWARE SOLUTIONS Ε.Ε.",
        "url": "https://moose.gr",
        "image": "https://moose.gr/og-image.jpg",
        "email": "info@moose.gr",
        "telephone": "+306980310555",
        "vatID": "EL803018698",
        "description": "Custom software development agency building high-performance web applications, Shopify e-shops, and tailored CRMs.",
        "areaServed": "GR",
        "knowsAbout": ["Web Applications", "E-commerce", "Shopify", "CRM", "Custom Software"],
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Leoforos Kifisias 44",
          "addressLocality": "Marousi",
          "postalCode": "151 25",
          "addressRegion": "Attica",
          "addressCountry": "GR"
        }
      }
    </script>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-T4JVVFKQ"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <slot />
  </body>
</html>
