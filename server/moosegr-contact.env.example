# Copy to /etc/moosegr-contact.env on the server, then:
#   sudo chown root:root /etc/moosegr-contact.env
#   sudo chmod 600 /etc/moosegr-contact.env
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@moose.gr
# Google app password (myaccount.google.com/apppasswords), spaces removed.
SMTP_PASSWORD=changeme
CONTACT_TO=info@moose.gr
BIND_ADDR=127.0.0.1
BIND_PORT=8321
